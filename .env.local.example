# 数据库连接设置 (开发环境)
# 您可以使用Docker运行PostgreSQL: docker run --name postgres -e POSTGRES_PASSWORD=password -p 5432:5432 -d postgres
POSTGRES_PRISMA_URL=postgresql://postgres:password@localhost:5432/chatgpt_next_web
POSTGRES_URL_NON_POOLING=postgresql://postgres:password@localhost:5432/chatgpt_next_web

# NextAuth密钥 (必需，可使用以下命令生成: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secure-nextauth-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OpenAI API配置 (可选)
OPENAI_API_KEY=your-openai-api-key-here 